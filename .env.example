# 应用部署地址，用于 ZITADEL 回调与账号邮件链接；生产环境使用 HTTPS。
APP_URL=http://localhost:3000
# 站点基本路径，默认 /；例如 /auth。修改后重启开发服务，生产环境需重新构建。
BASE_PATH=/

# 品牌配置（仅有站点昵称与图标两个选项）
SITE_NICKNAME=wy ci
# 可填 /icon.svg 或 https://static.example.com/icon.svg
SITE_ICON=

# ZITADEL API 地址；容器部署可使用内部地址，例如 http://zitadel:8080
ZITADEL_API_URL=
# ZITADEL 对外域名，不带协议或路径；内部 HTTP API 请求会带上该公开 Host 以定位实例
ZITADEL_EXTERNALDOMAIN=
# 可选：额外/覆盖请求头，格式为 Header:Value,Header:Value
CUSTOM_REQUEST_HEADERS=
# 服务账号 PAT（二选一；文件路径优先，适合挂载 Docker/Kubernetes Secret）
ZITADEL_SERVICE_TOKEN=
ZITADEL_SERVICE_USER_TOKEN_FILE=
# 可选：默认组织 ID；Authorization Request 含组织 scope 时以 scope 为准
ZITADEL_ORGANIZATION_ID=

# 用于待完成登录 Cookie 的独立随机密钥，使用 openssl rand -base64 32 生成
SESSION_SECRET=
